{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubo.app/buboskin.schema.json",
  "title": "Bubo Skin",
  "description": "A skin theme file for the Bubo calendar app. Required fields describe the skin's mood; optional fields cover stylistic choices. Layout depth, materials, semantic colors, shadows, animation physics and symbol rendering are fixed globally and must not be customized per skin. Unknown fields are rejected — the minimal set IS the canonical set.",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "author",
    "accentColor",
    "prefersDarkTint",
    "backgroundGradient",
    "previewColors"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "description": "Unique identifier (lowercase_snake_case). Permanent after release."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Display name shown in the skin picker."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Author name or @github_handle."
    },
    "accentColor": {
      "$ref": "#/$defs/color",
      "description": "Primary accent color. Must reach at least 3:1 contrast against white per Apple HIG."
    },
    "prefersDarkTint": {
      "type": "boolean",
      "description": "Whether this skin has a dark-tinted mood. Also controls derived shadow depth."
    },
    "backgroundGradient": {
      "$ref": "#/$defs/gradient",
      "description": "Background gradient specification — the 'wallpaper' feel of the skin."
    },
    "previewColors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/color"
      },
      "minItems": 1,
      "maxItems": 2,
      "description": "1–2 colors for the skin picker thumbnail."
    },
    "secondaryAccent": {
      "$ref": "#/$defs/color",
      "description": "Optional secondary accent for button gradients. Falls back to a dimmed accentColor."
    },
    "barTint": {
      "$ref": "#/$defs/color",
      "description": "Optional color wash on the top/bottom bar material."
    },
    "barTintOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25,
      "default": 0.08,
      "description": "Opacity of the bar tint overlay."
    },
    "platterTint": {
      "$ref": "#/$defs/color",
      "description": "Optional color wash on card/platter surfaces."
    },
    "platterTintOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.15,
      "default": 0.05,
      "description": "Opacity of the platter tint overlay."
    },
    "buttonStyle": {
      "type": "string",
      "enum": [
        "solid",
        "gradient",
        "glass"
      ],
      "default": "gradient",
      "description": "Primary button fill style."
    },
    "buttonShape": {
      "type": "string",
      "enum": [
        "capsule",
        "roundedRect",
        "rectangle"
      ],
      "default": "capsule",
      "description": "Primary button clip shape."
    },
    "buttonColor": {
      "$ref": "#/$defs/color",
      "description": "Explicit foreground color for primary buttons. Overrides auto-contrast logic."
    },
    "buttonAccentColor": {
      "$ref": "#/$defs/color",
      "description": "Optional accent override for primary button backgrounds only."
    },
    "buttonSecondaryAccent": {
      "$ref": "#/$defs/color",
      "description": "Optional secondary accent override for primary button gradient end-point."
    },
    "buttonTint": {
      "$ref": "#/$defs/color",
      "description": "Optional color overlay on glass-style primary buttons."
    },
    "fontWeight": {
      "$ref": "#/$defs/fontWeight",
      "default": "regular",
      "description": "Body/button font weight. Headline and SF Symbol weights are derived from this value."
    },
    "fontDesign": {
      "type": "string",
      "enum": [
        "rounded",
        "default",
        "serif",
        "monospaced"
      ],
      "default": "rounded",
      "description": "System font face. `rounded` is Bubo's historical SF Rounded voice; `default` uses SF Pro Text/Display (Apple marketing-site face)."
    },
    "badgeStyle": {
      "type": "string",
      "enum": [
        "filled",
        "outlined",
        "tinted"
      ],
      "default": "tinted",
      "description": "Badge/pill appearance style."
    },
    "separatorStyle": {
      "type": "string",
      "enum": [
        "system",
        "subtle",
        "accent",
        "none"
      ],
      "default": "subtle",
      "description": "Separator/divider appearance style."
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|[a-zA-Z]+(:([0-9]*\\.?[0-9]+))?)$",
      "description": "Hex (#RRGGBB or #RRGGBBAA), named (accentColor), named:opacity (accentColor:0.5), or keyword (clear, white, black, gray).",
      "examples": [
        "#0070FA",
        "#0070FA80",
        "accentColor",
        "accentColor:0.5",
        "clear"
      ]
    },
    "fontWeight": {
      "type": "string",
      "enum": [
        "regular",
        "semibold",
        "bold"
      ],
      "description": "Font weight. Apple's design system forbids weight 500 (`medium`); only regular / semibold / bold are allowed."
    },
    "gradient": {
      "type": "object",
      "required": [
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          },
          "description": "Gradient color stops."
        },
        "style": {
          "type": "string",
          "enum": [
            "linear",
            "radial",
            "clear"
          ],
          "description": "Gradient type."
        },
        "startPoint": {
          "$ref": "#/$defs/unitPoint",
          "description": "Linear gradient start point."
        },
        "endPoint": {
          "$ref": "#/$defs/unitPoint",
          "description": "Linear gradient end point."
        },
        "center": {
          "$ref": "#/$defs/unitPoint",
          "description": "Radial gradient center point."
        },
        "startRadius": {
          "type": "number",
          "minimum": 0,
          "description": "Radial gradient start radius."
        },
        "endRadius": {
          "type": "number",
          "minimum": 0,
          "description": "Radial gradient end radius."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "style": {
                "const": "linear"
              }
            }
          },
          "then": {
            "required": [
              "colors"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "style": {
                "const": "radial"
              }
            }
          },
          "then": {
            "required": [
              "colors"
            ]
          }
        }
      ]
    },
    "unitPoint": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "leading",
        "trailing",
        "topLeading",
        "topTrailing",
        "bottomLeading",
        "bottomTrailing",
        "center"
      ],
      "description": "A point in the unit coordinate space."
    }
  }
}
